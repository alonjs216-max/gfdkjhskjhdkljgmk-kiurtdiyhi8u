<?xml version="1.0" encoding="utf-8"?>
<!--
    Notification panel. Same glass language as the widgets, but a touch brighter so it
    reads well inside both the light and the dark system notification shade.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="135"
                android:type="linear"
                android:startColor="#FF241A45"
                android:centerColor="#FF181231"
                android:endColor="#FF120D22" />
        </shape>
    </item>

    <!-- Aurora blob, primary -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:type="radial"
                android:centerX="0.08"
                android:centerY="0.0"
                android:gradientRadius="130%p"
                android:startColor="#5CA78BFA"
                android:endColor="#00A78BFA" />
        </shape>
    </item>

    <!-- Aurora blob, secondary -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:type="radial"
                android:centerX="1.0"
                android:centerY="1.0"
                android:gradientRadius="100%p"
                android:startColor="#3DF472B6"
                android:endColor="#00F472B6" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#38FFFFFF" />
        </shape>
    </item>
</layer-list>
