<?xml version="1.0" encoding="utf-8"?>
<!-- Inner glass tile, same feel as MetricCard in the app. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="135"
                android:type="linear"
                android:startColor="#26FFFFFF"
                android:centerColor="#12FFFFFF"
                android:endColor="#08FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#24FFFFFF" />
        </shape>
    </item>
</layer-list>
